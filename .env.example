# Copie este arquivo para `.env` e ajuste se necessário.
# O `.env` NUNCA vai para o Git (contém senhas); este exemplo vai.

# Usados pelo docker-compose.yml para criar o banco local
POSTGRES_USER=clinicflow
POSTGRES_PASSWORD=clinicflow_dev
POSTGRES_DB=clinicflow

# Endereço que o app e o Drizzle usam para conectar no banco
# formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgres://clinicflow:clinicflow_dev@localhost:5432/clinicflow

# Login (Better Auth)
# Chave secreta que assina os cookies de sessão. Gere uma nova para cada ambiente:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=troque-por-uma-chave-gerada
# Endereço público do app
BETTER_AUTH_URL=http://localhost:8080
